---
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Contact | SocialScape',
	description: 'Contact Page',
};
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>Contact Us</h1>
				<p>
					Ready to accelerate your capital formation journey? Our team of fundraising specialists is here to discuss how we can help you achieve your investment objectives. Whether you're planning your next funding round or seeking to expand your investor network, let's explore how our vast network of investor and AI-driven solutions can transform your fundraising strategy.
					<br>
					<br>
Schedule a confidential consultation:

Transform your fundraising potential with SocialScape's proven methodology that has helped firms secure Multi-Million Dollar Investments in just 90 days.
				</p>
				<div>
					<p>
						<em><a href="tel:+14809526946">+1(480) 952-6946</a></em> • <em
							><a href="mailto:contact@trysocialscape.co.uk">contact@trysocialscape.co.uk</a
							></em
						>
					</p>
				</div>
			</div>
			<div class="col-2__container">
				<!-- Calendly inline widget begin -->
				<div class="calendly-inline-widget" data-url="https://calendly.com/socialscape0/investor-solutions-wrap-up" style="min-width:320px;height:700px;"></div>
				<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
				<!-- Calendly inline widget end -->
			</div>
		</section>
	</Container>
</Layout>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
	}
</style>
