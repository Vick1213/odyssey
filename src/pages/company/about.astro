---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About | SocialScape',
	description: 'Your dedicated partner in capital raising and investor networking',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>About SocialScape</h1>
			<p>
				SocialScape is your dedicated partner in accelerating capital raising rounds 
				and building valuable investor networks. We specialize in helping Private Equity 
				firms, VCs, and companies connect with qualified investors through either our vast network of investors or 
				guaranteed performance-based system.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/SScap.jpg"
        alt="SocialScape Capital Raising"
        id="home-hero-image"
        style="max-width: 100%; width: 520px; height: auto;;"
      />
    </picture>
	</HeroSection>
  <TextSection wide>
    <!-- Mission Section -->
    <section class="mission-block">
      <h2>Our Mission</h2>
      <p>
        We're revolutionizing the fundraising landscape by combining AI-driven technology with human expertise. Our proven system consistently delivers 15 qualified investors monthly, helping firms like a leading UK-based VC raise $8.5M in just 90 days. We focus on the channels where modern investors make decisions: LinkedIn and Email.
      </p>
    </section>
  
    <!-- Approach Section -->
    <section class="approach-block">
      <h2>Our Approach</h2>
      <p>
        SocialScape stands apart through our dual-powered methodology that marries technological innovation with human insight. At the heart of our operation lies our proprietary AI-driven investor acquisition systems, enabling sophisticated targeting across family offices, ultra-high-net-worth individuals, registered investment advisors, and institutional investors. Our data-driven matching algorithms ensure strategic alignment, while automated nurture sequences maintain consistent engagement throughout the fundraising journey.
Yet technology is only half the equation. Our dedicated fundraising specialists become a seamless extension of your team, crafting customized outreach strategies that reflect your unique value proposition. We focus on building long-term relationships that extend beyond immediate rounds, integrating smoothly with your existing processes to enhance rather than disrupt your operations
      </p>
    </section>
  
    <!-- Vision Section -->
    <section class="vision-block">
      <h2>Our Vision</h2>
      <p>
        We believe that access to capital shouldn't be the barrier between great ideas and their realization. Through our innovative approach, we're democratizing access to funding by breaking down traditional fundraising barriers through technology. Our platform accelerates growth by reducing fundraising cycles from years to months, while simultaneously building lasting connections between ventures and aligned investors. This comprehensive approach drives innovation by enabling the next generation of groundbreaking companies to secure the capital they need to thrive.
      </p>
    </section>
  
    <!-- Values Section -->
    <section class="values-block">
      <h2>Our Values</h2>
      <div class="values-grid">
        <div class="value-item">
          <h3>Innovation First</h3>
          <p>
            We constantly push the boundaries of what's possible in capital raising through 
            cutting-edge technology and creative solutions.
          </p>
        </div>
        <div class="value-item">
          <h3>Integrity & Commitment</h3>
          <p>
            We believe in building trust through honest communication and maintaining 
            the highest standards of professional integrity.
          </p>
        </div>
        <div class="value-item">
          <h3>Results-Driven</h3>
          <p>
            Our performance-based model reflects our commitment to delivering tangible 
            results for our clients.
          </p>
        </div>
        <div class="value-item">
          <h3>Client Success</h3>
          <p>
            Your success is our success. We're dedicated to providing personalized 
            solutions that drive real business growth.
          </p>
        </div>
      </div>
    </section>
  
    <!-- Team Section -->
    <section class="team-block">
      <h2>Meet Our Team</h2>
      <div class="team-grid">
        <div class="team-member">
          <picture>
            <img
              src="/assets/images/team/saatvik.jpg"
              alt="Saatvik Choudhary"
              class="team-photo"
            />
          </picture>
          <h3>Saatvik Choudhary</h3>
          <p class="team-role">Co-Founder & CEO</p>
          <p>
            A visionary leader with a strong command of crypto markets, venture capital (VC), and private equity (PE) ecosystems, Saatvik leverages advanced AI-driven technologies to position Socialscape at the forefront of innovation, ensuring operational excellence and strategic foresight.
          </p>
        </div>
  
        <div class="team-member">
          <picture>
            <img
              src="/assets/images/team/parth.jpg"
              alt="Parth Sharma"
              class="team-photo"
            />
          </picture>
          <h3>Parth Sharma</h3>
          <p class="team-role">Managing Director & Founder</p>
          <p>
            A trailblazing entrepreneur and the driving force behind Socialscape, Parth has a proven track record of structuring complex VC & PE frameworks, crafting bespoke investor outreach solutions, and orchestrating successful capital-raising ventures across multiple industries.
          </p>
        </div>
  
        <div class="team-member">
          <picture>
            <img
              src="/assets/images/team/chris.jpg"
              alt="Chris Richardson"
              class="team-photo"
            />
          </picture>
          <h3>Chris Richardson</h3>
          <p class="team-role"><b>Head of Business Development</b></p>
          <p>
            With over 15 years of expertise in sales, corporate finance, and strategic growth, Chris excels in fostering high-value client relationships, streamlining business operations, and delivering scalable, data-driven outcomes that drive sustainable revenue growth.
          </p>
        </div>
      </div>
    </section>
  </TextSection>
</Layout>  
<style>
  .TextSection {
  font-size: 1.2rem; /* Increase text size for better readability */
  line-height: 1.8; /* Improve line spacing for readability */
  margin-bottom: 2rem; /* Add spacing between sections */
}

/* Section Headings */
.TextSection h2 {
  font-size: 2rem;
  margin-bottom: 1rem;
  text-align: center;
  color: #333;
}

/* Mission & Approach Blocks */
.mission-block, .approach-block, .vision-block {
  margin-bottom: 2rem;
  padding: 1rem;
  background-color: #e6e4e0;
  border-radius: 8px;
}
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .value-item {
    padding: 1.5rem;
    background:  #e6e4e0;
    border-radius: 8px;
  }
  
  .value-item2 {
    padding: 1.5rem;
    background: #f8f9fa;
    border-radius: 9px;
  }

  .team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 3rem;
  margin: 2rem 0;
}

.team-member {
  text-align: center; /* Ensure text alignment is centered */
}

.team-photo {
  display: block; /* Ensures the image behaves like a block element */
  margin: 0 auto; /* Horizontally centers the image */
  width: 200px;
  height: 200px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 1rem;
}


  .team-role {
    color: #666;
    font-style: italic;
    margin: 0.5rem 0;
  }
</style>