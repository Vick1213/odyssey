---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About | SocialScape',
	description: 'Your dedicated partner in capital raising and investor networking',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>About SocialScape</h1>
			<p>
				SocialScape is your dedicated partner in accelerating capital raising rounds 
				and building valuable investor networks. We specialize in helping Private Equity 
				firms, VCs, and companies connect with qualified investors through our 
				guaranteed performance-based system.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/classic-hero.jpg"
        alt="SocialScape Capital Raising"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>
  <TextSection narrow>
    <p>
      Our mission is to transform how companies approach fundraising. We've developed 
      a proven system that generates 11 to 22 monthly qualified new business opportunities 
      within just 3 months, focusing on where investors actually spend their time: 
      LinkedIn and Email.
    </p>
    
    <p>
      What sets us apart is our comprehensive approach to capital raising. We design 
      and implement custom software solutions to improve operational efficiency, while 
      our dedicated fundraising specialists work to connect you with family offices, 
      accredited high-net-worth individuals, and institutional investors.
    </p>

    <h2>Our Vision</h2>
    <p>
      At SocialScape, we envision a future where capital raising is no longer a bottleneck 
      for innovative companies. We believe in democratizing access to investment 
      opportunities by leveraging technology and human expertise. Our goal is to create 
      a seamless bridge between promising ventures and potential investors, fostering 
      growth and innovation across industries.
    </p>
    
    <h2>Our Values</h2>
    <div class="values-grid">
      <div class="value-item">
        <h3>Innovation First</h3>
        <p>We constantly push the boundaries of what's possible in capital raising through 
        cutting-edge technology and creative solutions.</p>
      </div>
      
      <div class="value-item">
        <h3>Integrity & Transparency</h3>
        <p>We believe in building trust through honest communication and maintaining 
        the highest standards of professional integrity.</p>
      </div>
      
      <div class="value-item">
        <h3>Results-Driven</h3>
        <p>Our performance-based model reflects our commitment to delivering tangible 
        results for our clients.</p>
      </div>
      
      <div class="value-item">
        <h3>Client Success</h3>
        <p>Your success is our success. We're dedicated to providing personalized 
        solutions that drive real business growth.</p>
      </div>
    </div>

    <h2>Meet Our Team</h2>
    <div class="team-grid">
      <div class="team-member">
        <picture>
          <img
            src="/assets/images/team/saatvik.jpg"
            alt="Saatvik Choudhary"
            class="team-photo"
          />
        </picture>
        <h3>Saatvik Choudhary</h3>
        <p class="team-role">Outbound Systems & AI Integration Lead</p>
        <p>Driving innovation through advanced AI solutions and automated systems, 
        Saatvik ensures our technology stays ahead of the curve.</p>
      </div>

      <div class="team-member">
        <picture>
          <img
            src="/assets/images/team/parth.jpg"
            alt="Parth Sharma"
            class="team-photo"
          />
        </picture>
        <h3>Parth Sharma</h3>
        <p class="team-role">Outbound Systems & AI Integration Lead</p>
        <p>Specializing in developing scalable outbound systems, Parth works to 
        optimize our client outreach and engagement processes.</p>
      </div>

      <div class="team-member">
        <picture>
          <img
            src="/assets/images/team/chris.jpg"
            alt="Chris Richardson"
            class="team-photo"
          />
        </picture>
        <h3>Chris Richardson</h3>
        <p class="team-role">Business Development Head</p>
        <p>With extensive experience in business development, Chris leads our 
        strategic growth initiatives and client relationship management.</p>
      </div>
    </div>
  </TextSection>
</Layout>

<style>
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .value-item {
    padding: 1.5rem;
    background: #f8f9fa;
    border-radius: 8px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
    margin: 2rem 0;
  }

  .team-member {
    text-align: center;
  }

  .team-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
  }

  .team-role {
    color: #666;
    font-style: italic;
    margin: 0.5rem 0;
  }
</style>