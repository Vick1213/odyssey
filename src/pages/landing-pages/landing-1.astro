---
import { Icon } from 'astro-icon/components';
import {
	AnnouncementBar,
	Button,
	CustomerQuoteSection,
	ThreeColumnTextSection,
	YouTubeEmbedSection,
	StickyTextImageSection,
	CtaCardSection,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';

const seo = {
	title: 'SocialScape | Capital Raising Partners',
	description: 'Get To know SocialScape| Capital Raising partners',
};
---

<AnnouncementBar
	text="Read Our Latest Blog Post"
	href="/blog/posts/SocialScape-empowering-capital/"
	slot="announcement-bar"
/>
<Layout {seo}>
	<TextAndImageHero reversed>
		<div slot="text-container">
			<h1>Don't Reinvent the Wheel</h1>
			<p>Create Value without wasting precious time</p>
		</div>
		<div slot="btns-container">
			<Button href="/theme/get-started" customIcon
				>Get Started <Fragment slot="icon">
					<Icon name="ic:baseline-chevron-right" />
				</Fragment></Button
			>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/landing-1/landing-hero-1.jpg"
				alt="Astro Odyssee"
				id="home-hero-image"
			/>
		</picture>
	</TextAndImageHero>

	<CustomerQuoteSection
		caseStudyLink="/blog/posts/consider-hybrid-work"
		downloadLink="files\PitchDeckSS.pdf"
	/>

	<ThreeColumnTextSection>
		<div slot="column-1-body">
			<h2>Why?</h2>
			<p >
			VC and PE firms thrive on speed, not traditional delays. Socialscape streamlines your capital connections, tapping into our network to save you time and effort. Build faster, smarter, and focus on scaling.
			</p>
		</div>
		<Button slot="column-1-cta" outlined href= "/company/contact">Raise Now </Button>
		<div slot="column-2-body">
			<h2>How?</h2>
			<p>
				With our vast network and bespoke software, Socialscape connects VC and PE firms to the ideal investor base. Our tailored system ensures deeper engagement, driving higher conversion rates and meaningful results.

			</p>
		</div>
		<Button slot="column-2-cta" outlined href= "/company/contact">Acquire Immediately </Button>
		<div slot="column-3-body">
			<h2>When?</h2>
			<p>
				Efficiency is our priority. Once you join Socialscape, we connect you with suitable investors from our network immediately. Beyond that, we ensure you have multiple high-quality meetings every week, driving rapid results.
			</p>
		</div>
		<Button slot="column-3-cta"outlined  href= "/company/contact">Secure Funds </Button>
	</ThreeColumnTextSection>

	<YouTubeEmbedSection url="https://www.youtube.com/watch?v=cbYr75_R15M" rounded
	/>

	<StickyTextImageSection>
		<div slot="text-container">
			<h2>Features</h2>
			<h3>immediate Results</h3>
			<p>
				At Socialscape, we understand the importance of speed. Our platform
				ensures you connect with the right investors immediately, driving
				efficient results.
				
			</p>
			<h3>Qualified Investors</h3>
			<p>
				With SocialScape you dont have to constantly attend networking events to find the right investors. We have a network of qualified investors that are ready to invest in your business.
			</p>
			<h3>Customised experience</h3>
			<p>
				completely Customised and personally taylored solutions to help you raise capital for your business.
			</p>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/landing-1/landing-sticky.jpg"
				alt="Astro Odyssey"
				loading="lazy"
			/>
		</picture>
	</StickyTextImageSection>


</Layout>
